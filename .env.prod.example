# =============================================================
# DevBuddy .env.prod  —  copy to .env.prod and fill in values
# NEVER commit the real .env.prod to git
# =============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=devbuddy
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32
POSTGRES_DB=devbuddy

# ── App ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_RANDOM_64_HEX_CHARS
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Supabase (Authentication) ─────────────────────────────────
# Get from: supabase.com → project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJ...YOUR_ANON_KEY
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET_FROM_SUPABASE_SETTINGS

# ── Frontend (built into the Docker image at build time) ──────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...YOUR_ANON_KEY
# Use your VM's external IP or domain
VITE_API_BASE_URL=http://YOUR_VM_IP:8000

# ── LLM Provider ─────────────────────────────────────────────
# Options: groq (free) | openai | ollama | together
# Groq free tier: console.groq.com → API Keys
LLM_PROVIDER=groq
LLM_MODEL=llama3-8b-8192
LLM_API_KEY=gsk_YOUR_GROQ_API_KEY
# For ollama (local, free): set LLM_PROVIDER=ollama, no API key needed
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_API_BASE=http://localhost:11434

# ── Data Storage (persistent disk paths) ─────────────────────
# All data goes here — survives VM reboots
DATA_ROOT=/opt/devbuddy/data
WORKSPACE_ROOT=/opt/devbuddy/data/workspaces
REPOS_ROOT=/opt/devbuddy/data/repos

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# =============================================================
# DevBuddy .env.prod  —  copy to .env.prod and fill in values
# NEVER commit the real .env.prod to git
# =============================================================

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=devbuddy
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_base64_32
POSTGRES_DB=devbuddy

# ── App ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_RANDOM_64_HEX_CHARS
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Supabase (Authentication) ─────────────────────────────────
# Get from: supabase.com → project → Settings → API
SUPABASE_URL=https://oahumeurdneffekoerqa.supabase.co
SUPABASE_ANON_KEY=sb_publishable_WCXQKuSKkQ268IRrpcxm7w_fZDBEqMO
SUPABASE_JWT_SECRET=FILL_FROM_GITHUB_SECRET

# ── Frontend (built into the Docker image at build time) ──────
VITE_SUPABASE_URL=https://oahumeurdneffekoerqa.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_WCXQKuSKkQ268IRrpcxm7w_fZDBEqMO
# Use your VM's external IP or domain
VITE_API_BASE_URL=http://YOUR_VM_IP:8000

# ── LLM Provider ─────────────────────────────────────────────
# Options: llama (Meta cloud) | groq (free) | openai | ollama | together
#
# --- Meta Llama API (recommended for GCP free tier) ---
# Sign up: llama.developer.meta.com → get API key
# Models: Llama-4-Scout-17B-16E-Instruct (fast) | Llama-4-Maverick-17B-128E-Instruct (smart)
LLM_PROVIDER=llama
LLM_MODEL=Llama-4-Scout-17B-16E-Instruct
LLM_API_KEY=YOUR_LLAMA_API_KEY
#
# --- Groq alternative (also free) ---
# Sign up: console.groq.com → API Keys
# LLM_PROVIDER=groq
# LLM_MODEL=llama3-8b-8192
# LLM_API_KEY=gsk_YOUR_GROQ_API_KEY
#
# --- Ollama (local only, not for GCP e2-micro) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

# ── Data Storage (persistent disk paths) ─────────────────────
# All data goes here — survives VM reboots
DATA_ROOT=/opt/devbuddy/data
WORKSPACE_ROOT=/opt/devbuddy/data/workspaces
REPOS_ROOT=/opt/devbuddy/data/repos

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

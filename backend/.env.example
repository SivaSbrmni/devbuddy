# DevBuddy Lite — Environment Variables
# Copy to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://devbuddy:devbuddy@localhost:5432/devbuddy

# LLM Providers
ANTHROPIC_API_KEY=sk-ant-...
LLAMA_API_KEY=llama-...

# GitHub
GITHUB_TOKEN=ghp_...

# Deployment
RAILWAY_TOKEN=
VERCEL_TOKEN=

# Security
SECRET_KEY=change-me-in-production-32-chars!

# App
ENVIRONMENT=development
DEBUG=true

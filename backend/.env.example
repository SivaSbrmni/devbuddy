# Backend Environment Variables
# Copy this to .env and fill in your values

# App Config
ENVIRONMENT=development
SECRET_KEY=change-me-to-32-char-random-string

# Database - Supabase Postgres
# Get this from Supabase Dashboard → Database → Connection String
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.REF.supabase.co:5432/postgres

# Supabase
# Get these from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# LLM Provider (choose one)
# Option 1: Local Ollama (no API key needed)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:latest

# Option 2: Llama API (Meta's official, 1000 req/day free)
# LLM_PROVIDER=llama
# LLM_MODEL=llama-3.1-70b
# LLM_API_KEY=la-your-key

# Option 3: OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4
# LLM_API_KEY=sk-your-key

# Option 4: Groq (fast inference)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.1-70b
# LLM_API_KEY=gsk-your-key

# Optional: E2B for sandboxed code execution
E2B_API_KEY=

# Optional: Sentry for error tracking
SENTRY_DSN=

# Optional: Default GitHub PAT
GITHUB_PAT=

# Sandbox Backend (e2b | subprocess | disabled)
# WARNING: Only use 'subprocess' in local development
SANDBOX_BACKEND=disabled
